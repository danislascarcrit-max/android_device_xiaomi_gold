type vendor_ram_expansion, domain;
type vendor_ram_expansion_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(vendor_ram_expansion)

# Allow executing /vendor/bin/sh, toolbox, and toybox_vendor.
allow vendor_ram_expansion vendor_shell_exec:file rx_file_perms;
allow vendor_ram_expansion vendor_toolbox_exec:file rx_file_perms;

# Read persistent vendor RAM expansion property.
get_prop(vendor_ram_expansion, vendor_ram_expansion_prop)

# Configure zram0 sysfs controls and swap block device.
allow vendor_ram_expansion sysfs_zram:dir r_dir_perms;
allow vendor_ram_expansion sysfs_zram:file rw_file_perms;
allow vendor_ram_expansion sysfs_zram:lnk_file r_file_perms;
allow vendor_ram_expansion block_device:dir search;
allow vendor_ram_expansion { ram_device swap_block_device }:blk_file rw_file_perms;

# Inspect swap state and adjust swappiness.
allow vendor_ram_expansion proc_swaps:file r_file_perms;
allow vendor_ram_expansion proc_meminfo:file r_file_perms;
allow vendor_ram_expansion proc_swappiness:file rw_file_perms;

# Required by mkswap/swapon/swapoff syscalls.
allow vendor_ram_expansion self:capability sys_admin;
