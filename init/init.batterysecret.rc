service batterysecret /vendor/bin/batterysecret
    class last_start
    user root
    group system wakelock
    disabled

on property:sys.boot_completed=1
    chown system system /sys/class/Charging_Adapter/pd_adapter/usbpd_verifed
    chown system system /sys/class/Charging_Adapter/pd_adapter/request_vdm_cmd
    chown system system /sys/class/Charging_Adapter/pd_adapter/verify_process
    chown system system /sys/class/power_supply/usb/pd_authentication
    chmod 0666 /sys/class/Charging_Adapter/pd_adapter/usbpd_verifed
    chmod 0666 /sys/class/Charging_Adapter/pd_adapter/request_vdm_cmd
    chmod 0666 /sys/class/Charging_Adapter/pd_adapter/verify_process
    chmod 0666 /sys/class/power_supply/usb/pd_authentication
    start batterysecret

#run batterysecret in off-charge mode
on charger
    chown system system /sys/class/Charging_Adapter/pd_adapter/usbpd_verifed
    chown system system /sys/class/Charging_Adapter/pd_adapter/request_vdm_cmd
    chown system system /sys/class/Charging_Adapter/pd_adapter/verify_process
    chown system system /sys/class/power_supply/usb/pd_authentication
    chmod 0666 /sys/class/Charging_Adapter/pd_adapter/usbpd_verifed
    chmod 0666 /sys/class/Charging_Adapter/pd_adapter/request_vdm_cmd
    chmod 0666 /sys/class/Charging_Adapter/pd_adapter/verify_process
    chmod 0666 /sys/class/power_supply/usb/pd_authentication
    start batterysecret
